{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/forgot-password.html"
    },
    {
      "source": "/reset-password",
      "destination": "/reset-password.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/dashboard/admin",
      "destination": "/dashboard/admin.html"
    },
    {
      "source": "/:slug((?!css|js|assets|dashboard|package|login|register|forgot-password|reset-password).*)",
      "destination": "/package/motion/velvet-garden/index.html"
    }
  ]
}
