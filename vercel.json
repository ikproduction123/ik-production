{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/dashboard/admin",
      "destination": "/dashboard/admin.html"
    },
    {
      "source": "/:slug((?!css|js|assets|dashboard|package|login|register|forgot-password|reset-password).*)",
      "destination": "/invitation.html"
    }
  ]
}
