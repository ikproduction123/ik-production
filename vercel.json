{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/anisa-bagas",
      "destination": "/package/motion/velvet-garden/index.html"
    },
    {
      "source": "/:slug",
      "destination": "/package/motion/velvet-garden/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
